---
import { NOINDEX } from "../site.config";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Backstop half of the noindex switch. The X-Robots-Tag header in
        vercel.json is the primary control; both are driven by NOINDEX in
        src/site.config.ts. See CLAUDE.md. */}
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}

    {/* Fonts are self-hosted (see scripts/fetch-fonts.sh). Preload only the
        two faces that paint above the fold. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/fraunces-300-900-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-sans-300-600-latin.woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" />

    <meta name="theme-color" content="#0e1f1b" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    {/* Appears once you are far enough down that the nav has scrolled away. */}
    <button class="totop" type="button" data-totop hidden aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 19V5M12 5l-6 6M12 5l6 6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <script>
      // Scroll reveals. One observer, unobserve after firing.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!reduced.matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 }
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-in"));
      }

      // Back to top. Hidden until you are a screen and a half down, so it
      // never competes with the hero.
      const toTop = document.querySelector<HTMLButtonElement>("[data-totop]");
      if (toTop) {
        const threshold = () => window.innerHeight * 1.5;
        const sync = () => {
          const show = window.scrollY > threshold();
          toTop.hidden = !show;
          toTop.classList.toggle("is-in", show);
        };
        sync();
        window.addEventListener("scroll", sync, { passive: true });

        toTop.addEventListener("click", () => {
          window.scrollTo({
            top: 0,
            behavior: reduced.matches ? "auto" : "smooth",
          });
          // Send focus somewhere sensible rather than leaving it on a button
          // that is about to disappear.
          document.querySelector<HTMLElement>(".skip")?.focus({ preventScroll: true });
        });
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.9rem 1.4rem;
        background: var(--ink);
        color: var(--bone);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .skip:focus {
        left: 0;
      }

      /* Same trap as the clinic filter: `display: grid` below would override
         the hidden attribute, leaving an invisible but clickable button. */
      .totop[hidden] {
        display: none;
      }

      .totop {
        position: fixed;
        right: clamp(1rem, 3vw, 2.25rem);
        bottom: clamp(1rem, 3vw, 2.25rem);
        z-index: 40;
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        padding: 0;
        color: var(--bone-pure);
        background: var(--drape-deep);
        border: 1px solid color-mix(in srgb, var(--bone) 22%, transparent);
        border-radius: 50%;
        cursor: pointer;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.4s var(--ease), transform 0.4s var(--ease-out),
          background-color 0.3s var(--ease);
      }

      .totop.is-in {
        opacity: 1;
        transform: none;
      }

      .totop:hover {
        background: var(--iodine);
      }

      .totop svg {
        width: 1.15rem;
        height: 1.15rem;
      }

      @media (prefers-reduced-motion: reduce) {
        .totop {
          transition: none;
          transform: none;
        }
      }
    </style>
  </body>
</html>
