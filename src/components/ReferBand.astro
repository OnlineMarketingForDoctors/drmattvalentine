---
import { Image } from "astro:assets";
import { getSettings } from "../sanity/loaders";
import orchidImg from "../assets/generated/orchidometer.png";

interface Props {
  /** Interior pages carry an id so the nav can target them. */
  id?: string;
}
const { id = "refer" } = Astro.props;
const SITE = await getSettings();
const band = SITE.referBand;
const orchid = band.orchidometer;
---

<section class="band band--dark refer" id={id}>
  <div class="wrap refer__inner">
    <div class="refer__main">
      <p class="tag tag--pale" data-reveal>{band.eyebrow}</p>
      <h2 data-reveal style="--delay:80ms">{band.heading}</h2>
      <p class="lede" data-reveal style="--delay:160ms">
        {band.lede}
      </p>

      <div class="refer__actions" data-reveal style="--delay:240ms">
        <a class="btn" href="/refer/">
          {band.cta}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost btn--on-dark" href={SITE.phoneHref}>
          {SITE.phoneLabel}
        </a>
      </div>

      <p class="refer__note" data-reveal style="--delay:320ms">
        {band.noteBefore} <a
          href={SITE.vasectomyAustralia}
          rel="nofollow noopener"
          target="_blank">{band.noteLink}</a
        > {band.noteAfter}
      </p>
    </div>

    {/* The orchidometer is the instrument the practice actually posts out to
        referring GPs — the same offer, and the same photograph, as on
        Dr Cashion's site. */}
    <aside class="refer__swag" data-reveal style="--delay:200ms">
      <div class="refer__swag-media">
        <Image
          src={orchidImg}
          alt={orchid.imageAlt}
          widths={[400, 700, 1000]}
          sizes="(min-width: 60rem) 24rem, 90vw"
          quality={80}
        />
      </div>
      <div class="refer__swag-body">
        <p class="tag tag--pale">{orchid.eyebrow}</p>
        <h3>{orchid.heading}</h3>
        <p>
          {orchid.body}
        </p>
        <a class="refer__swag-link" href={`mailto:${SITE.email}?subject=${encodeURIComponent(orchid.emailSubject)}`}>
          {orchid.linkLabel}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .refer__inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .refer__main h2 {
    margin-top: 0.3em;
    max-width: 12ch;
  }

  .refer__main .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
  }

  .refer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  .refer__note {
    margin-top: 1.6rem;
    max-width: 42ch;
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--drape-pale) 88%, transparent);
  }

  /* ---- orchidometer card ---- */
  .refer__swag {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    background: color-mix(in srgb, var(--bone) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--bone) 14%, transparent);
  }

  .refer__swag-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .refer__swag-body h3 {
    margin-top: 0.35em;
    margin-bottom: 0.7rem;
  }

  .refer__swag-body p {
    font-size: 0.95rem;
    color: var(--drape-pale);
    max-width: 38ch;
  }

  .refer__swag-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.2rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--iodine-bright);
    text-decoration: none;
  }

  .refer__swag-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .refer__swag-link .btn__arrow {
    transition: transform 0.4s var(--ease-out);
  }

  .refer__swag-link:hover .btn__arrow {
    transform: translateX(4px);
  }

  @media (min-width: 62rem) {
    .refer__inner {
      grid-template-columns: 1fr 24rem;
      align-items: start;
    }
  }
</style>
