---
import { SITE } from "../site.config";

const links = [
  { href: "/about", label: "About" },
  { href: "/vasectomy", label: "The procedure" },
  { href: "/vasectomy#clinics", label: "Clinics" },
  { href: "/contact", label: "Contact" },
];

interface Props {
  /** Set on pages whose hero is a pale background rather than a dark image,
      so the bar drops its scrim and inks its own type instead. */
  light?: boolean;
}
const { light = false } = Astro.props;

// mark the current section, tolerating a trailing slash
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href;
---

<header class:list={["nav", light && "nav--light"]} data-nav>
  <div class="nav__inner">
    <a class="nav__mark" href="/">
      <span class="nav__mark-name">Matt Valentine</span>
      {/* Split into glyphs so flex can track the tagline out to exactly the
          width of the name above it, whatever the font metrics turn out to
          be. The label carries the real text for assistive tech. */}
      <span class="nav__mark-role" aria-label="No-scalpel vasectomy">
        {
          [..."NO-SCALPEL VASECTOMY"].map((ch) => (
            <span aria-hidden="true" class={ch === " " ? "is-space" : undefined}>
              {ch === " " ? " " : ch}
            </span>
          ))
        }
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a class="nav__phone" href={SITE.phoneHref}>
        <span class="nav__phone-label">{SITE.phoneLabel}</span>
        <span class="nav__phone-digits">{SITE.phoneDigits}</span>
      </a>
      <a class="btn nav__cta" href="/contact#refer">Refer a patient</a>
      <button
        class="nav__burger"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span class="nav__burger-box" aria-hidden="true"><span></span></span>
        <span class="nav__sr">Menu</span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-nav-drawer hidden>
    <nav aria-label="Primary, mobile">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="nav__drawer-phone" href={SITE.phoneHref}>
        {SITE.phoneLabel} · {SITE.phoneDigits}
      </a>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");

  // The bar earns its background only once you've left the hero.
  const onScroll = () => nav?.classList.toggle("is-stuck", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!drawer || !toggle) return;
    drawer.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("is-open", open);
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => setOpen(drawer?.hidden ?? true));

  // Any navigation closes it, as does Escape.
  drawer?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
  }

  /* Over a bright hero the bar has nothing to sit on, so it brings its own
     shade until the solid background takes over. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 190%;
    background: linear-gradient(to bottom, rgba(14, 31, 27, 0.62), transparent);
    pointer-events: none;
    transition: opacity 0.5s var(--ease);
  }

  .nav.is-stuck::before {
    opacity: 0;
  }

  /* Over a pale hero the scrim would read as a smudge, so it goes — and the
     type inks itself to stay legible. Once the bar is stuck it is solid ink
     again, so the dark-hero treatment resumes and this all reverts. */
  /* .nav__inner sets its own colour, so the override has to land there rather
     than on .nav — inheritance loses to a direct declaration. */
  .nav--light:not(.is-stuck):not(.is-open) .nav__inner {
    color: var(--ink);
  }

  .nav--light:not(.is-stuck):not(.is-open)::before {
    opacity: 0;
  }

  .nav--light:not(.is-stuck):not(.is-open) .nav__mark-role,
  .nav--light:not(.is-stuck):not(.is-open) .nav__phone-label {
    color: var(--drape);
  }

  .nav--light:not(.is-stuck):not(.is-open) .nav__burger {
    border-color: color-mix(in srgb, var(--ink) 28%, transparent);
  }

  .nav.is-stuck,
  .nav.is-open {
    background: color-mix(in srgb, var(--ink) 92%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.4rem) var(--gutter);
    color: var(--bone);
  }

  .nav__mark {
    display: grid;
    gap: 0.15em;
    text-decoration: none;
    margin-right: auto;
  }

  .nav__mark-name {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    font-variation-settings: "opsz" 24, "SOFT" 20, "WONK" 1;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  /* justify-content spreads the glyphs across the grid column, which the
     name above sizes — so the two lines always end flush */
  .nav__mark-role {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--drape-pale);
    line-height: 1;
  }

  .nav__mark-role .is-space {
    /* the word gap has to stay wider than the letter gaps to still read as
       two words */
    min-width: 0.5em;
  }

  .nav__links {
    display: none;
    gap: clamp(1rem, 2vw, 2.1rem);
    font-size: 0.9rem;
  }

  .nav__links a {
    position: relative;
    text-decoration: none;
    padding-block: 0.3em;
    opacity: 0.82;
    transition: opacity 0.3s var(--ease);
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--iodine-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .nav__links a:hover,
  .nav__links a[aria-current="page"] {
    opacity: 1;
  }

  .nav__links a:hover::after,
  .nav__links a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.6rem);
  }

  .nav__phone {
    display: none;
    text-align: right;
    text-decoration: none;
    line-height: 1.15;
  }

  .nav__phone-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--bone) 80%, transparent);
  }

  .nav__phone-digits {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav__cta {
    display: none;
    padding: 0.75em 1.35em;
    font-size: 0.85rem;
  }

  /* ---- burger ---- */
  .nav__burger {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: none;
    border: 1px solid color-mix(in srgb, var(--bone) 30%, transparent);
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
  }

  .nav__burger-box {
    position: relative;
    display: block;
    width: 15px;
    height: 9px;
  }

  .nav__burger-box::before,
  .nav__burger-box::after,
  .nav__burger-box span {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out), opacity 0.2s var(--ease);
  }

  .nav__burger-box::before {
    top: 0;
  }
  .nav__burger-box span {
    top: 50%;
    margin-top: -0.75px;
  }
  .nav__burger-box::after {
    bottom: 0;
  }

  .nav.is-open .nav__burger-box::before {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav.is-open .nav__burger-box span {
    opacity: 0;
  }
  .nav.is-open .nav__burger-box::after {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .nav__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ---- drawer ---- */
  .nav__drawer {
    border-top: 1px solid color-mix(in srgb, var(--bone) 14%, transparent);
  }

  .nav__drawer nav {
    display: grid;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: 0.5rem var(--gutter) 1.6rem;
  }

  .nav__drawer a {
    padding: 0.95rem 0;
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 12%, transparent);
  }

  .nav__drawer a[aria-current="page"] {
    color: var(--iodine-bright);
  }

  .nav__drawer-phone {
    font-family: var(--mono) !important;
    font-size: 0.85rem !important;
    font-weight: 400 !important;
    letter-spacing: 0.06em;
    border-bottom: 0 !important;
    color: var(--drape-pale) !important;
    padding-top: 1.4rem !important;
  }

  @media (min-width: 60rem) {
    .nav__links,
    .nav__cta {
      display: flex;
    }
    .nav__phone {
      display: block;
    }
    .nav__burger,
    .nav__drawer {
      display: none;
    }
  }
</style>
