---
import { getSettings } from "../sanity/loaders";

const SITE = await getSettings();

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__mark">
      <p class="foot__name">{SITE.header.brandName}</p>
      <p class="tag tag--pale">{SITE.footer.tagline}</p>
      {/* AHPRA registration, required wherever a practitioner's regulated
          health services are advertised. In the footer it covers every page. */}
      <p class="foot__ahpra">AHPRA registration {SITE.ahpra}</p>
    </div>

    <nav class="foot__nav" aria-label="Footer">
      {SITE.footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="foot__phone" href={SITE.phoneHref}>
      <span class="tag tag--pale">{SITE.footer.phoneTag}</span>
      <span class="foot__phone-digits">{SITE.phoneLabel}</span>
      <span class="foot__phone-alt">{SITE.phoneDigits}</span>
    </a>
  </div>

  <div class="wrap foot__base">
    <p>
      © {year} {SITE.footer.copyrightHolder}. All rights reserved. ·
      <a class="foot__sitemap" href="/sitemap/">Sitemap</a>
    </p>
    <p>
      Powered by <a
        class="foot__omd"
        href="https://onlinemarketingfordoctors.com/"
        rel="nofollow noopener"
        target="_blank">Online Marketing For Doctors</a
      >
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--bone);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  .foot__inner {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .foot__name {
    font-family: var(--display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 600;
    font-variation-settings: "opsz" 48, "SOFT" 20, "WONK" 1;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .foot__ahpra {
    margin: 0.75rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--bone) 70%, transparent);
  }

  .foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    font-size: 0.95rem;
  }

  .foot__nav a {
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s var(--ease);
  }

  .foot__nav a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .foot__phone {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
  }

  .foot__phone-digits {
    font-family: var(--display);
    font-size: 1.5rem;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
  }

  .foot__phone-alt {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--drape-pale);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 15%, transparent);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--bone) 62%, transparent);
  }

  .foot__base p {
    margin: 0;
  }

  .foot__sitemap {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: color 0.3s var(--ease), text-decoration-color 0.3s var(--ease);
  }

  .foot__sitemap:hover {
    color: var(--bone);
    text-decoration-color: currentColor;
  }

  .foot__omd {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: color 0.3s var(--ease), text-decoration-color 0.3s var(--ease);
  }

  .foot__omd:hover {
    color: var(--bone);
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .foot__inner {
      grid-template-columns: 1fr auto auto;
      align-items: start;
      gap: 3rem;
    }
    .foot__nav {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
