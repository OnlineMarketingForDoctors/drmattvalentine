---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Where the subject sits, so the scrim can fall on the empty half. */
  focus?: string;
  crumb: string;
}

const { eyebrow, title, lede, image, imageAlt, focus = "center", crumb } = Astro.props;
---

<section class="phero" id="top">
  <div class="phero__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[900, 1400, 2000, 2600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={80}
      style={`object-position:${focus}`}
    />
  </div>
  <div class="phero__scrim"></div>

  <div class="wrap phero__inner">
    <nav class="phero__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{crumb}</span>
    </nav>

    <p class="tag tag--pale phero__eyebrow">{eyebrow}</p>
    <h1 class="phero__title">{title}</h1>
    {lede && <p class="lede phero__lede">{lede}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 44rem);
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .phero__media {
    position: absolute;
    inset: 0;
  }

  .phero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: pheroIn 1.6s var(--ease-out) both;
  }

  @keyframes pheroIn {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .phero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(14, 31, 27, 0.92) 0%, rgba(14, 31, 27, 0.68) 42%, rgba(14, 31, 27, 0.15) 74%),
      linear-gradient(to top, rgba(14, 31, 27, 0.88) 0%, transparent 48%);
  }

  .phero__inner {
    position: relative;
    padding-top: clamp(7rem, 16vh, 10rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .phero__crumb {
    display: flex;
    gap: 0.6em;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--drape-pale) 85%, transparent);
    margin-bottom: 1.6rem;
    animation: riseIn 0.8s var(--ease-out) 0.2s both;
  }

  .phero__crumb a {
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .phero__crumb a:hover {
    color: var(--iodine-bright);
  }

  .phero__eyebrow {
    animation: riseIn 0.9s var(--ease-out) 0.3s both;
  }

  .phero__title {
    max-width: 17ch;
    margin-top: 0.45em;
    animation: riseIn 1s var(--ease-out) 0.42s both;
  }

  .phero__lede {
    max-width: 40ch;
    margin-top: 1.4rem;
    color: var(--drape-pale);
    animation: riseIn 1s var(--ease-out) 0.56s both;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 47.99rem) {
    .phero__scrim {
      background: linear-gradient(
        to bottom,
        rgba(14, 31, 27, 0.8) 0%,
        rgba(14, 31, 27, 0.66) 40%,
        rgba(14, 31, 27, 0.93) 100%
      );
    }
  }
</style>
