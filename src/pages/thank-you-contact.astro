---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";
---

{/*
  Permanently noindex — see the noindex prop below. A thank-you page carries
  no content worth ranking, and if it ever did rank it would send people to a
  confirmation screen instead of the page they wanted. It stays out of the
  index after launch, and is deliberately absent from /sitemap/ and llms.txt.
*/}
<Base
  title="Thank you — question received — Dr Matt Valentine"
  description="Confirmation page."
  noindex
>
  <Nav light />

  <main id="main">
    <section class="band ty">
      <div class="wrap ty__inner">
        <p class="tag">Question received</p>
        <h1>Your question is with Dr Valentine's rooms.</h1>
        <p class="lede">He answers these himself, so a reply may take a day or two if he is on the road. If it is time-critical, phone the rooms and ask for him directly.</p>

        <div class="ty__actions">
          <a class="btn" href="/">
            Back to the home page
            <span class="btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
          <a class="btn btn--ghost" href="/contact/">Back to contact</a>
        </div>

        <p class="ty__phone">
          <a href={SITE.phoneHref}>{SITE.phoneLabel} &middot; {SITE.phoneDigits}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .ty {
    padding-top: clamp(9rem, 20vh, 13rem);
  }

  .ty__inner {
    max-width: 44rem;
  }

  .ty__inner h1 {
    margin-top: 0.3em;
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.6rem);
    max-width: 22ch;
  }

  .ty__inner .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
  }

  .ty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.4rem;
  }

  .ty__phone {
    margin-top: 2.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .ty__phone a {
    color: var(--drape);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--drape) 40%, transparent);
  }

  .ty__phone a:hover {
    color: var(--iodine);
    border-color: var(--iodine);
  }
</style>
