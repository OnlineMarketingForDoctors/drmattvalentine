---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import LocationFinder from "../components/LocationFinder.astro";
import ReferBand from "../components/ReferBand.astro";
import RichText from "../components/RichText.astro";
import SanityImage from "../components/SanityImage.astro";
import { webPage, medicalProcedure } from "../lib/schema";
import { getPage, getSettings } from "../sanity/loaders";

const [SITE, page] = await Promise.all([getSettings(), getPage("/vasectomy/")]);
const { technique, advantages, clearance, locations, guide } = page;
const title = page.metaTitle;
const description = page.metaDescription;
---

<Base
  title={title}
  description={description}
  schema={[await webPage({ name: page.title, description, path: "/vasectomy/" }, Astro.site), await medicalProcedure(Astro.site)]}
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow={page.eyebrow}
      title={page.heading}
      lede={page.lede}
      image={page.heroImage}
      crumb={page.breadcrumb}
    />

    <!-- ============================================ TECHNIQUE -->
    <section class="band tech" id="technique">
      <div class="wrap tech__inner">
        <div class="tech__body">
          <p class="tag" data-reveal>{technique.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{technique.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            {technique.lede}
          </p>
          <RichText value={technique.body} reveal={{ start: 220 }} />
        </div>
        <figure class="tech__media" data-reveal style="--delay:140ms">
          <SanityImage image={technique.image} widths={[600, 1000, 1500]} sizes="(min-width: 62rem) 40vw, 90vw" quality={80} />
          <figcaption>
            {technique.caption}
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================ ADVANTAGES -->
    <section class="band band--drape adv" id="advantages">
      <div class="wrap">
        <p class="tag tag--pale" data-reveal>{advantages.eyebrow}</p>
        <h2 class="adv__title" data-reveal style="--delay:80ms">
          {advantages.heading}
        </h2>
        <dl class="adv__grid">
          {
            advantages.items.map((a: { heading: string; body: string }, i: number) => (
              <div class="advitem" data-reveal style={`--delay:${140 + i * 80}ms`}>
                <dt>{a.heading}</dt>
                <dd>{a.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============================================ CLEARANCE -->
    <section class="band clear" id="clearance">
      <div class="wrap clear__inner">
        <div class="clear__media" data-reveal>
          <SanityImage image={clearance.image} widths={[700, 1100, 1600]} sizes="(min-width: 60rem) 46vw, 90vw" quality={80} />
        </div>
        <div class="clear__body">
          <p class="tag" data-reveal>{clearance.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{clearance.heading}</h2>
          <RichText value={clearance.body} reveal={{ start: 160 }} />
        </div>
      </div>
    </section>

    <!-- ============================================ CLINICS -->
    <LocationFinder id="clinics" content={locations} />

    <!-- ============================================ GUIDE -->
    {/* Placeholder path: this becomes a direct download once the PDF is hosted.
        Until then it requests the guide by email rather than pointing at a
        dead link. */}
    <section class="band band--dark guide" id="guide">
      <div class="wrap guide__inner">
        <div>
          <p class="tag tag--pale" data-reveal>{guide.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{guide.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            {guide.lede}
          </p>
        </div>
        <a
          class="btn guide__cta"
          href={`mailto:${SITE.email}?subject=${encodeURIComponent(guide.emailSubject)}`}
          data-reveal
          style="--delay:220ms"
        >
          {guide.ctaLabel}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<style>
  .tech__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .tech__body h2 {
    margin-top: 0.3em;
    max-width: 14ch;
  }

  .tech__body .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
  }

  .tech__body p:not(.lede) {
    margin-top: 1.2rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .tech__media {
    margin: 0;
  }

  .tech__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tech__media figcaption {
    margin-top: 0.9rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  /* ---- advantages ---- */
  .adv__title {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .adv__grid {
    display: grid;
    gap: 2.25rem 3rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .advitem dt {
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 600;
    font-variation-settings: "opsz" 36, "SOFT" 20, "WONK" 0;
    letter-spacing: -0.015em;
    padding-bottom: 0.7rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 22%, transparent);
  }

  .advitem dd {
    margin: 0;
    font-size: 0.97rem;
    color: var(--drape-pale);
  }

  /* ---- clearance ---- */
  .clear__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .clear__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .clear__body h2 {
    margin-top: 0.3em;
    margin-bottom: 1.2rem;
    max-width: 18ch;
  }

  .clear__body p {
    margin-bottom: 1.1rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  /* ---- guide ---- */
  .guide__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .guide__inner h2 {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .guide__inner .lede {
    margin-top: 1.2rem;
    max-width: 44ch;
  }

  .guide__cta {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .adv__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .tech__inner {
      grid-template-columns: 55fr 45fr;
    }
    .clear__inner {
      grid-template-columns: 46fr 54fr;
    }
    .guide__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
