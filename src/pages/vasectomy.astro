---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import LocationFinder from "../components/LocationFinder.astro";
import ReferBand from "../components/ReferBand.astro";
import { SITE, STATS } from "../site.config";

import procedureRoom from "../assets/generated/procedure-room.webp";
import instruments from "../assets/generated/instruments.webp";
import leaving from "../assets/generated/leaving.webp";

/* Straight from the current site's list of advantages, expanded only where a
   referring GP would otherwise have to ring and ask. */
const advantages = [
  {
    k: "Local anaesthetic",
    v: `The procedure takes under ${STATS.minutes} minutes and is performed under local anaesthetic. No general, no sedation, no theatre booking.`,
  },
  {
    k: "He drives himself",
    v: "Your patient drives to the appointment and drives home from it. No escort, no recovery bay, no day off arranged around someone else's roster.",
  },
  {
    k: "Quick recovery",
    v: "Most men are back to desk work within a day or two and to physical work inside a week, with the usual advice about lifting and rest in between.",
  },
  {
    k: `${STATS.cost} out of pocket`,
    v: "That is the figure after the Medicare rebate, and it is the same at every clinic. The equivalent procedure with a urologist can reach $5,000.",
  },
];
---

<Base
  title="No-scalpel vasectomy — technique, recovery, cost and clinic locations"
  description="No-scalpel vasectomy with Dr Matt Valentine: the technique, the appointment, recovery, clearance testing, cost, and every clinic across Queensland, Victoria and Western Australia."
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow="The procedure"
      title="No scalpel, one opening, no stitches."
      lede="Under local anaesthetic, in under twenty minutes, at whichever of the nineteen clinics is nearest your patient."
      image={procedureRoom}
      imageAlt="An empty, prepared day-procedure room with a surgical green drape and instrument trolley"
      focus="center"
      crumb="Vasectomy"
    />

    <!-- ============================================ TECHNIQUE -->
    <section class="band tech" id="technique">
      <div class="wrap tech__inner">
        <div class="tech__body">
          <p class="tag" data-reveal>The technique</p>
          <h2 data-reveal style="--delay:80ms">Two techniques, folded together.</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            Dr Valentine has been performing vasectomies in Brisbane since
            {STATS.startYear}, initially trained in the traditional technique by
            Dr Greg Silver. In {STATS.nsvYear} he trained in the United States in
            the no-scalpel technique.
          </p>
          <p data-reveal style="--delay:220ms">
            Holding both matters more than it sounds. The no-scalpel approach
            uses a ringed clamp and a sharp dissecting forceps to reach the vas
            through a single small opening that is spread rather than cut — but
            when anatomy does not cooperate, the traditional training is what
            there is to fall back on.
          </p>
          <p data-reveal style="--delay:270ms">
            The opening is small enough that it is closed with a dressing rather
            than sutures.
          </p>
        </div>

        <figure class="tech__media" data-reveal style="--delay:140ms">
          <Image
            src={instruments}
            alt="A no-scalpel vasectomy instrument set laid out on a surgical green drape"
            widths={[600, 1000, 1500]}
            sizes="(min-width: 62rem) 40vw, 90vw"
            quality={80}
          />
          <figcaption>
            The ringed clamp and dissecting forceps that give the technique its
            name — no blade among them.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================ ADVANTAGES -->
    <section class="band band--drape adv" id="advantages">
      <div class="wrap">
        <p class="tag tag--pale" data-reveal>What to tell your patient</p>
        <h2 class="adv__title" data-reveal style="--delay:80ms">
          Four things that decide it for most men.
        </h2>
        <dl class="adv__grid">
          {
            advantages.map((a, i) => (
              <div class="advitem" data-reveal style={`--delay:${140 + i * 80}ms`}>
                <dt>{a.k}</dt>
                <dd>{a.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============================================ CLEARANCE -->
    <section class="band clear" id="clearance">
      <div class="wrap clear__inner">
        <div class="clear__media" data-reveal>
          <Image
            src={leaving}
            alt="A patient walking out of a suburban medical centre to the car park"
            widths={[700, 1100, 1600]}
            sizes="(min-width: 60rem) 46vw, 90vw"
            quality={80}
          />
        </div>
        <div class="clear__body">
          <p class="tag" data-reveal>Afterwards</p>
          <h2 data-reveal style="--delay:80ms">It is not contraception until it is cleared.</h2>
          <p data-reveal style="--delay:160ms">
            The single most important thing to say in the room: a vasectomy is
            not effective on the day it is performed. Your patient needs a
            post-vasectomy semen analysis, and must keep using other
            contraception until that result confirms clearance.
          </p>
          <p data-reveal style="--delay:210ms">
            The practice organises the test and the result. If anything about it
            is unclear when it reaches you, ring — that is exactly the sort of
            call Dr Valentine would rather take than not.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================ CLINICS -->
    <LocationFinder id="clinics" />

    <!-- ============================================ GUIDE -->
    {/* Placeholder path: this becomes a direct download once the PDF is hosted.
        Until then it requests the guide by email rather than pointing at a
        dead link. */}
    <section class="band band--dark guide" id="guide">
      <div class="wrap guide__inner">
        <div>
          <p class="tag tag--pale" data-reveal>For your patient</p>
          <h2 data-reveal style="--delay:80ms">The vasectomy information guide.</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            A plain-language booklet covering the procedure, the recovery and the
            clearance test — written to be handed over at the end of a
            consultation and read at home.
          </p>
        </div>
        <a
          class="btn guide__cta"
          href={`mailto:${SITE.email}?subject=${encodeURIComponent("Vasectomy information guide")}`}
          data-reveal
          style="--delay:220ms"
        >
          Request the guide
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<style>
  .tech__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .tech__body h2 {
    margin-top: 0.3em;
    max-width: 14ch;
  }

  .tech__body .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
  }

  .tech__body p:not(.lede) {
    margin-top: 1.2rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .tech__media {
    margin: 0;
  }

  .tech__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tech__media figcaption {
    margin-top: 0.9rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  /* ---- advantages ---- */
  .adv__title {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .adv__grid {
    display: grid;
    gap: 2.25rem 3rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .advitem dt {
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 600;
    font-variation-settings: "opsz" 36, "SOFT" 20, "WONK" 0;
    letter-spacing: -0.015em;
    padding-bottom: 0.7rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 22%, transparent);
  }

  .advitem dd {
    margin: 0;
    font-size: 0.97rem;
    color: var(--drape-pale);
  }

  /* ---- clearance ---- */
  .clear__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .clear__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .clear__body h2 {
    margin-top: 0.3em;
    margin-bottom: 1.2rem;
    max-width: 18ch;
  }

  .clear__body p {
    margin-bottom: 1.1rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  /* ---- guide ---- */
  .guide__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .guide__inner h2 {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .guide__inner .lede {
    margin-top: 1.2rem;
    max-width: 44ch;
  }

  .guide__cta {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .adv__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .tech__inner {
      grid-template-columns: 55fr 45fr;
    }
    .clear__inner {
      grid-template-columns: 46fr 54fr;
    }
    .guide__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
