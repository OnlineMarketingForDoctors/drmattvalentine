---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ReferBand from "../components/ReferBand.astro";
import { SITE } from "../site.config";
import { valentineCount } from "../data/locations";

import desk from "../assets/generated/desk.webp";
---

<Base
  title="Contact Dr Matt Valentine — questions about a patient"
  description="Contact Dr Matt Valentine's rooms about a patient referral for no-scalpel vasectomy. Phone 1800 SNIPME, email, or send a question directly."
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow="Contact"
      title="Ask about a patient."
      lede="An open invitation to referring doctors: if there is a question worth asking before the referral, ask it."
      image={desk}
      imageAlt="Dr Matt Valentine reading a referral letter at his desk"
      focus="center"
      crumb="Contact"
    />

    <!-- ============================================ FORM -->
    <section class="band cform" id="ask">
      <div class="wrap cform__inner">
        <div class="cform__intro">
          <p class="tag" data-reveal>Send a question</p>
          <h2 data-reveal style="--delay:80ms">He will come back to you.</h2>
          <p class="cform__note" data-reveal style="--delay:160ms">
            Fill this out and Dr Valentine will contact you as soon as he can —
            bearing in mind he may be in a room in Rockhampton when it arrives.
            Please keep patient identifiers out of the message; a description of
            the clinical question is enough to get a useful answer.
          </p>
          <p class="cform__aside" data-reveal style="--delay:220ms">
            Not a GP? Patients book directly through Vasectomy Australia rather
            than through these rooms.
          </p>

          <dl class="cform__direct" data-reveal style="--delay:280ms">
            <div>
              <dt>Phone</dt>
              <dd><a href={SITE.phoneHref}>{SITE.phoneLabel} · {SITE.phoneDigits}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
            <div>
              <dt>Facebook</dt>
              <dd>
                <a href={SITE.facebook} rel="noopener noreferrer" target="_blank">
                  Vasectomy Australia
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <form class="cform__form" data-cform novalidate>
          <div class="field">
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="cf-practice">Practice</label>
            <input id="cf-practice" name="practice" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="cf-phone">Phone <span class="field__opt">optional</span></label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div class="field field--wide">
            <label for="cf-message">Your question</label>
            <textarea id="cf-message" name="message" rows="5" required></textarea>
          </div>

          <div class="cform__actions">
            <button class="btn" type="submit">
              Send question
              <span class="btn__arrow" aria-hidden="true">→</span>
            </button>
            <p class="cform__status" data-cform-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>

    <!-- ============================================ WHERE -->
    <section class="band band--drape where" id="where">
      <div class="wrap where__inner">
        <div data-reveal>
          <p class="tag tag--pale">Clinics</p>
          <h2>{valentineCount} clinics, three states.</h2>
          <p class="lede">
            If the question is simply "where is the nearest one", the full list
            is on the procedure page, filterable by state.
          </p>
          <a class="btn btn--ghost btn--on-dark" href="/vasectomy#clinics">
            Find a clinic
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<script>
  /*
   * Interim submission path: a static site has nowhere to POST, so rather
   * than a form that silently fails, this opens the sender's own mail client
   * with the message prefilled. Swap for a real endpoint when one exists.
   */
  const form = document.querySelector<HTMLFormElement>("[data-cform]");
  const status = document.querySelector<HTMLElement>("[data-cform-status]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? "").trim();

    const name = get("name");
    const email = get("email");
    const message = get("message");

    if (!name || !email || !message) {
      if (status) {
        status.textContent = "Add your name, email and question before sending.";
        status.dataset.state = "error";
      }
      return;
    }

    const body = [
      `Name: ${name}`,
      `Practice: ${get("practice") || "—"}`,
      `Email: ${email}`,
      `Phone: ${get("phone") || "—"}`,
      "",
      message,
    ].join("\n");

    const href =
      `mailto:info@vasectomyaustralia.com.au` +
      `?subject=${encodeURIComponent(`Question about a patient — ${name}`)}` +
      `&body=${encodeURIComponent(body)}`;

    window.location.href = href;

    if (status) {
      status.textContent = "Opening your email app with the message ready to send.";
      status.dataset.state = "ok";
    }
  });
</script>

<style>
  .cform__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .cform__intro h2 {
    margin-top: 0.3em;
    max-width: 14ch;
  }

  .cform__note {
    margin-top: 1.3rem;
    max-width: 42ch;
    color: var(--ink-soft);
  }

  .cform__aside {
    margin-top: 1.1rem;
    max-width: 42ch;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .cform__direct {
    display: grid;
    gap: 1.1rem;
    margin: 2.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .cform__direct dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .cform__direct dd {
    margin: 0.2rem 0 0;
    font-size: 0.98rem;
  }

  .cform__direct a {
    /* the email is long enough to overrun a narrow column and collide with
       the next one, so it is allowed to break */
    overflow-wrap: anywhere;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding-bottom: 0.1em;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .cform__direct a:hover {
    color: var(--iodine);
    border-color: var(--iodine);
  }

  /* ---- form ---- */
  .cform__form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bone-pure);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field label {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .field__opt {
    text-transform: none;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85em 1em;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--bone);
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 0;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--drape);
    background: var(--bone-pure);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--iodine-bright);
    outline-offset: 2px;
  }

  .cform__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .cform__status {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .cform__status[data-state="error"] {
    color: var(--iodine);
  }

  /* ---- where ---- */
  .where__inner h2 {
    margin-top: 0.3em;
    max-width: 14ch;
  }

  .where__inner .lede {
    margin-top: 1.2rem;
    margin-bottom: 2rem;
    max-width: 42ch;
  }

  @media (min-width: 40rem) {
    .cform__form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .field--wide,
    .cform__actions {
      grid-column: 1 / -1;
    }
    /* auto-fit rather than a fixed three, so the column count follows the
       space the intro column actually has */
    .cform__direct {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  @media (min-width: 62rem) {
    .cform__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
