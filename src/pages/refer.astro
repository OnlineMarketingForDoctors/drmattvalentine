---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { SITE, STATS } from "../site.config";
import { valentineCount } from "../data/locations";

import instruments from "../assets/generated/instruments.webp";

/* Field list mirrors the referral form on the Vasectomy Australia sites:
   the patient's details first, then the referrer's. */
const patientFields = [
  { id: "p-first", name: "patient_first", label: "Patient's first name", type: "text", autocomplete: "off", required: true },
  { id: "p-last", name: "patient_last", label: "Patient's last name", type: "text", autocomplete: "off", required: true },
  { id: "p-phone", name: "patient_phone", label: "Patient's phone number", type: "tel", autocomplete: "off", required: true },
  { id: "p-email", name: "patient_email", label: "Patient's email", type: "email", autocomplete: "off", required: false },
];

const doctorFields = [
  { id: "d-first", name: "doctor_first", label: "Doctor's first name", type: "text", autocomplete: "given-name", required: true },
  { id: "d-last", name: "doctor_last", label: "Doctor's last name", type: "text", autocomplete: "family-name", required: true },
  { id: "d-clinic", name: "doctor_clinic", label: "Doctor's clinic name", type: "text", autocomplete: "organization", required: true },
  { id: "d-email", name: "doctor_email", label: "Doctor's email", type: "email", autocomplete: "email", required: true },
];
---

<Base
  title="Refer a patient — Dr Matt Valentine"
  description="Refer a patient to Dr Matt Valentine for no-scalpel vasectomy. Send the patient's details and your practice details, across 19 clinics in Queensland, Victoria and Western Australia."
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow="Refer a patient"
      title="Send him our way."
      lede="Patient details, your details, and he takes it from there."
      image={instruments}
      imageAlt="A no-scalpel vasectomy instrument set laid out on a surgical green drape"
      focus="center"
      crumb="Refer a patient"
    />

    <section class="band refer" id="refer">
      <div class="wrap refer__inner">
        <div class="refer__intro">
          <p class="tag" data-reveal>For referring doctors</p>
          <h2 data-reveal style="--delay:80ms">Are you a GP with a patient for vasectomy?</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            Dr Valentine has performed {STATS.career} no-scalpel vasectomies
            across {valentineCount} clinics, and aims to give your patient the
            highest standard of clinical care.
          </p>
          <p class="refer__note" data-reveal style="--delay:220ms">
            Urgent cases are accommodated within {STATS.urgentWeeks} weeks
            wherever possible. If you would rather talk it through first, the
            rooms are on <a href={SITE.phoneHref}>{SITE.phoneLabel}</a>.
          </p>
        </div>

        {/*
          Not wired to a backend yet, by request. The submit handler blocks the
          default GET so the page cannot appear to succeed while going nowhere.
          Point it at a real endpoint before launch and drop the status line.
        */}
        <form class="rform" data-rform novalidate data-reveal style="--delay:120ms">
          <fieldset class="rform__set">
            <legend class="rform__legend">Patient's details</legend>
            <div class="rform__grid">
              {
                patientFields.map((f) => (
                  <div class="field">
                    <label for={f.id}>
                      {f.label}
                      {!f.required && <span class="field__opt">optional</span>}
                    </label>
                    <input
                      id={f.id}
                      name={f.name}
                      type={f.type}
                      autocomplete={f.autocomplete}
                      required={f.required}
                    />
                  </div>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="rform__set">
            <legend class="rform__legend">Referring doctor's details</legend>
            <div class="rform__grid">
              {
                doctorFields.map((f) => (
                  <div class="field">
                    <label for={f.id}>{f.label}</label>
                    <input
                      id={f.id}
                      name={f.name}
                      type={f.type}
                      autocomplete={f.autocomplete}
                      required={f.required}
                    />
                  </div>
                ))
              }
            </div>
          </fieldset>

          <div class="field field--wide">
            <label for="r-notes">
              Anything he should know <span class="field__opt">optional</span>
            </label>
            <textarea id="r-notes" name="notes" rows="4"></textarea>
          </div>

          <div class="rform__actions">
            <button class="btn" type="submit">
              Send referral
              <span class="btn__arrow" aria-hidden="true">→</span>
            </button>
            <p class="rform__status" data-rform-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  /*
   * Deliberately not connected to a submission endpoint yet. Rather than let
   * the browser fire a default GET that silently loses the referral, this
   * blocks submission and says so. Replace with a real POST before launch.
   */
  const form = document.querySelector<HTMLFormElement>("[data-rform]");
  const status = document.querySelector<HTMLElement>("[data-rform-status]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (status) {
      status.textContent =
        "This form is not connected yet — please phone 1800 764 763 to refer.";
      status.dataset.state = "pending";
    }
  });
</script>

<style>
  .refer__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .refer__intro h2 {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .refer__intro .lede {
    margin-top: 1.3rem;
    max-width: 42ch;
  }

  .refer__note {
    margin-top: 1.2rem;
    max-width: 42ch;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  .refer__note a {
    color: var(--iodine);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--iodine) 40%, transparent);
  }

  .refer__note a:hover {
    border-color: var(--iodine);
  }

  /* ---- form ---- */
  .rform {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bone-pure);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .rform__set {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rform__legend {
    display: block;
    width: 100%;
    padding: 0 0 0.9rem;
    margin-bottom: 1.25rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--drape);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .rform__grid {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field label {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .field__opt {
    margin-left: 0.6em;
    text-transform: none;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85em 1em;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--bone);
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 0;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 6.5rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--drape);
    background: var(--bone-pure);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--iodine-bright);
    outline-offset: 2px;
  }

  .rform__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .rform__status {
    font-size: 0.88rem;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .rform__status[data-state="pending"] {
    color: var(--iodine);
  }

  @media (min-width: 34rem) {
    .rform__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .refer__inner {
      grid-template-columns: 40fr 60fr;
    }
  }
</style>
