---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { getLocations, getSettings, getStats } from "../sanity/loaders";

const [SITE, STATS, { valentineCount }] = await Promise.all([getSettings(), getStats(), getLocations()]);
import { webPage } from "../lib/schema";

import instruments from "../assets/generated/instruments.webp";

const title = "Refer a patient — Dr Matt Valentine";
const description = `Refer a patient to Dr Matt Valentine for no-scalpel vasectomy. Send the patient's details and your practice details, across ${valentineCount} clinics in Queensland, Victoria and Western Australia.`;
---

<Base
  title={title}
  description={description}
  schema={await webPage({ name: "Refer a patient", description, path: "/refer/" }, Astro.site)}
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow="Refer a patient"
      title="Send him our way."
      lede="Patient details, your details, and he takes it from there."
      image={instruments}
      imageAlt="A no-scalpel vasectomy instrument set laid out on a surgical green drape"
      focus="center"
      crumb="Refer a patient"
    />

    <section class="band refer" id="refer">
      <div class="wrap refer__inner">
        <div class="refer__intro">
          <p class="tag" data-reveal>For referring doctors</p>
          <h2 data-reveal style="--delay:80ms">Are you a GP with a patient for vasectomy?</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            Dr Valentine has performed {STATS.career} no-scalpel vasectomies
            across {valentineCount} clinics, and aims to give your patient the
            highest standard of clinical care.
          </p>
          <p class="refer__note" data-reveal style="--delay:220ms">
            Urgent cases are accommodated within {STATS.urgentWeeks} weeks
            wherever possible. If you would rather talk it through first, the
            rooms are on <a href={SITE.phoneHref}>{SITE.phoneLabel}</a>.
          </p>
        </div>

        {/*
          Wufoo-hosted referral form, supplied by the practice. The snippet is
          third-party and must run exactly as written, so it carries is:inline
          to keep Astro from bundling or rewriting it.

          The redirect after submission is configured in Wufoo itself, NOT
          here — point it at /thank-you-refer/. The <div> below is Wufoo's own
          no-JS fallback.
        */}
        <div class="rform rform--embed" data-reveal style="--delay:120ms">
          <div id="wufoo-z1funy0c0agqy7q">
            Fill out my <a
              href="https://vasectomyaustralia.wufoo.com/forms/z1funy0c0agqy7q"
              target="_blank"
              rel="nofollow noopener">online form</a
            >.
          </div>
          <script type="text/javascript" is:inline>
            var z1funy0c0agqy7q;(function(d, t) {
            var s = d.createElement(t), options = {
            'userName':'vasectomyaustralia',
            'formHash':'z1funy0c0agqy7q',
            'autoResize':true,
            'height':'627',
            'async':true,
            'host':'wufoo.com',
            'header':'show',
            'ssl':true};
            s.src = ('https:' == d.location.protocol ?'https://':'http://') + 'secure.wufoo.com/scripts/embed/form.js';
            s.onload = s.onreadystatechange = function() {
            var rs = this.readyState; if (rs) if (rs != 'complete') if (rs != 'loaded') return;
            try { z1funy0c0agqy7q = new WufooForm();z1funy0c0agqy7q.initialize(options);z1funy0c0agqy7q.display(); } catch (e) { }};
            var scr = d.getElementsByTagName(t)[0], par = scr.parentNode; par.insertBefore(s, scr);
            })(document, 'script');
          </script>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .refer__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .refer__intro h2 {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .refer__intro .lede {
    margin-top: 1.3rem;
    max-width: 42ch;
  }

  .refer__note {
    margin-top: 1.2rem;
    max-width: 42ch;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  .refer__note a {
    color: var(--iodine);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--iodine) 40%, transparent);
  }

  .refer__note a:hover {
    border-color: var(--iodine);
  }

  /* ---- embedded form ---- */
  .rform--embed {
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--bone-pure);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* Wufoo injects its own iframe; it has to be free to size itself since
     autoResize is on, and it must not overflow the card on a phone. */
  .rform--embed :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  /* The no-JS fallback line, which Wufoo replaces once the form loads. */
  .rform--embed #wufoo-z1funy0c0agqy7q {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .rform--embed #wufoo-z1funy0c0agqy7q a {
    color: var(--iodine);
  }

  @media (min-width: 62rem) {
    .refer__inner {
      grid-template-columns: 40fr 60fr;
    }
  }
</style>
