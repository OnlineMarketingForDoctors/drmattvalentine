---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ReferBand from "../components/ReferBand.astro";
import RichText from "../components/RichText.astro";
import SanityImage from "../components/SanityImage.astro";
import { webPage } from "../lib/schema";
import { getPage, getSettings } from "../sanity/loaders";

const [SITE, page] = await Promise.all([getSettings(), getPage("/about/")]);
const { intro, career, offDuty } = page;
const title = page.metaTitle;
const description = page.metaDescription;
---

<Base
  title={title}
  description={description}
  schema={await webPage({ name: page.title, description, path: "/about/" }, Astro.site)}
>
  <Nav />

  <main id="main">
    <PageHero
      eyebrow={page.eyebrow}
      title={page.heading}
      lede={page.lede}
      image={page.heroImage}
      crumb={page.breadcrumb}
    />

    <!-- ============================================ OPENING -->
    <section class="band open">
      <div class="wrap open__inner">
        <div class="open__body">
          <p class="tag" data-reveal>{intro.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">
            {intro.heading}
          </h2>
          <p class="lede" data-reveal style="--delay:160ms">
            {intro.lede}
          </p>
          <RichText value={intro.body} reveal={{ start: 220 }} />
        </div>

        <figure class="open__portrait" data-reveal style="--delay:140ms">
          <SanityImage image={intro.portrait} widths={[500, 800, 1200]} sizes="(min-width: 62rem) 24rem, 80vw" quality={82} />
          <figcaption>
            <span class="tag">{intro.captionName}</span>
            {intro.captionCredentials}
            <span class="open__ahpra">AHPRA registration {SITE.ahpra}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================ CAREER -->
    <section class="band band--dark career" id="career">
      <div class="wrap">
        <p class="tag tag--pale" data-reveal>{career.eyebrow}</p>
        <h2 class="career__title" data-reveal style="--delay:80ms">
          {career.heading}
        </h2>

        <ol class="career__list">
          {
            career.milestones.map((c: { year: string; title: string; body: string }, i: number) => (
              <li data-reveal style={`--delay:${120 + i * 70}ms`}>
                <span class="career__year">{c.year}</span>
                <div class="career__body">
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============================================ OFF DUTY -->
    <section class="band off">
      <div class="wrap off__inner">
        <div class="off__media" data-reveal>
          <SanityImage image={offDuty.image} widths={[700, 1100, 1600]} sizes="(min-width: 60rem) 46vw, 90vw" quality={82} />
        </div>
        <div class="off__body">
          <p class="tag" data-reveal>{offDuty.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{offDuty.heading}</h2>
          <RichText value={offDuty.body} reveal={{ start: 160 }} />
        </div>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<style>
  .open__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .open__body h2 {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .open__body .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
  }

  .open__body p:not(.lede) {
    margin-top: 1.2rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .open__portrait {
    margin: 0;
  }

  .open__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 22%;
    background: var(--drape-wash);
  }

  .open__portrait figcaption {
    margin-top: 0.9rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .open__portrait figcaption .tag {
    display: block;
    color: var(--drape);
    margin-bottom: 0.15rem;
  }

  /* Regulatory text, so it holds the same weight as the caption it sits in
     rather than being the faintest thing on the page. */
  .open__ahpra {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  /* ---- career ---- */
  .career__title {
    margin-top: 0.3em;
    max-width: 16ch;
  }

  .career__list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
  }

  .career__list li {
    display: grid;
    gap: 0.6rem 2.5rem;
    padding: 1.9rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 20%, transparent);
  }

  .career__year {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--iodine-bright);
    padding-top: 0.3em;
  }

  .career__body h3 {
    margin-bottom: 0.6rem;
  }

  .career__body p {
    color: var(--drape-pale);
    font-size: 0.98rem;
    max-width: 56ch;
  }

  /* ---- off duty ---- */
  .off__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .off__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .off__body h2 {
    margin-top: 0.3em;
    margin-bottom: 1.2rem;
    max-width: 15ch;
  }

  .off__body p {
    margin-bottom: 1.1rem;
    max-width: 44ch;
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .career__list li {
      grid-template-columns: 7rem 1fr;
    }
  }

  @media (min-width: 62rem) {
    .open__inner {
      grid-template-columns: 1fr 24rem;
    }
    .off__inner {
      grid-template-columns: 46fr 54fr;
    }
  }
</style>
