---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { webPage } from "../lib/schema";
import { getPages } from "../sanity/loaders";

const pages = await getPages();

const title = "Sitemap — Dr Matt Valentine";
const description = "Every page on drmattvalentine.com.au.";
---

<Base
  title={title}
  description={description}
  schema={await webPage({ name: "Sitemap", description, path: "/sitemap/" }, Astro.site)}
>
  <Nav light />

  <main id="main">
    <section class="band smap">
      <div class="wrap">
        <p class="tag">Sitemap</p>
        <h1>Every page, in one list.</h1>
        <p class="lede measure">
          Six pages. If you are looking for a clinic, the full list sits on the
          procedure page and filters by state.
        </p>

        <ol class="smap__list">
          {
            pages.map((p, i) => (
              <li>
                <span class="smap__n">{String(i + 1).padStart(2, "0")}</span>
                <span class="smap__body">
                  <a href={p.path}>{p.title}</a>
                  <span class="smap__blurb">{p.blurb}</span>
                  <span class="smap__path">{p.path}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .smap {
    padding-top: clamp(9rem, 20vh, 13rem);
  }

  .smap h1 {
    margin-top: 0.3em;
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.6rem);
    max-width: 20ch;
  }

  .smap .lede {
    margin-top: 1.3rem;
  }

  .smap__list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .smap__list li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .smap__n {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--drape);
    padding-top: 0.55em;
  }

  .smap__body {
    display: grid;
    gap: 0.3rem;
  }

  .smap__body a {
    font-family: var(--display);
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
    letter-spacing: -0.012em;
    text-decoration: none;
    justify-self: start;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .smap__body a:hover {
    color: var(--iodine);
    border-color: var(--iodine);
  }

  .smap__blurb {
    font-size: 0.94rem;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .smap__path {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--ink) 50%, transparent);
  }
</style>
